# Painel, envio de planilha e coleta na mesma imagem.
#
# A coleta usa Chromium em modo janela dentro de um display virtual (Xvfb).
# Headless devolve zero: os comparadores recusam o Chromium headless. Xvfb da
# um navegador real desenhando numa tela que ninguem ve, sem falsificar
# identidade.
#
# Limite conhecido: fonte que exige verificacao humana ou sessao autenticada
# nao funciona aqui, porque nao ha ninguem para concluir o desafio e o IP e de
# datacenter. Para essas, colete na maquina do operador e publique em
# POST /ingest.
FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RPA_DATA_DIR=/dados \
    RPA_HEADLESS=false \
    REQUEST_DELAY_SECONDS=4.0 \
    RPA_LOJAS_PREFERIDAS="mercado livre,shopee" \
    RPA_SOMENTE_EXATOS=true \
    RPA_AGENDA_DIA=1 \
    DISPLAY=:99

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir --break-system-packages \
        "openpyxl>=3.1,<4" \
        "playwright==1.61.0" \
        "fastapi>=0.115,<1" \
        "uvicorn[standard]>=0.32,<1" \
        "python-multipart>=0.0.9" \
    && pip install --no-cache-dir --break-system-packages --no-deps .

# Roda como root: o volume do Railway e montado com dono root e um usuario
# sem privilegio nao consegue gravar nele.
RUN mkdir -p /dados

EXPOSE 8000

# O display virtual sobe em segundo plano e o servidor assume o processo
# principal. Feito assim de proposito: com `xvfb-run` o container ficava preso
# antes de abrir a porta, e uma falha do X derrubava o painel junto. Aqui, se
# o X nao subir, o painel continua servindo e so a coleta fica indisponivel.
CMD ["sh", "-c", "Xvfb :99 -screen 0 1440x1000x24 -nolisten tcp & export DISPLAY=:99; exec copercitrus-web"]
