# Imagem unica: painel, envio de planilha e coleta.
#
# A coleta usa Chromium em modo janela dentro de um display virtual (Xvfb).
# Rodar headless devolve zero resultado: os comparadores recusam o Chromium
# headless. Xvfb da um navegador real desenhando numa tela que ninguem ve, sem
# falsificar identidade.
#
# O que este container NAO resolve: fonte que exige verificacao humana ou
# sessao autenticada. Google e Shopee bloqueiam IP de datacenter e nao ha
# ninguem para concluir o desafio. Para essas, colete na maquina do operador e
# publique em POST /ingest.
FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RPA_DATA_DIR=/dados \
    RPA_HEADLESS=false \
    REQUEST_DELAY_SECONDS=4.0 \
    RPA_LOJAS_PREFERIDAS="mercado livre,shopee" \
    RPA_AGENDA_DIA=1

WORKDIR /app

COPY pyproject.toml README.md requirements.txt ./
COPY src ./src

RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --no-deps .

RUN mkdir -p /dados && chown pwuser:pwuser /dados /app
USER pwuser

# O volume e declarado na plataforma (Railway Volumes), nao no Dockerfile.
EXPOSE 8000

# xvfb-run cria o display virtual antes de subir o servidor, para a coleta
# disparada pela tela ou pela agenda encontrar um X disponivel.
CMD ["xvfb-run", "-a", "--server-args=-screen 0 1440x1000x24", "copercitrus-web"]
