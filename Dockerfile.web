# Imagem do painel e do envio de planilha. Sem navegador de proposito.
#
# A coleta exige navegador com sessao valida e, em algumas fontes, alguem para
# concluir a verificacao humana. Servidor nao tem nenhum dos dois. Entao a
# coleta roda na maquina do operador e publica o resultado em POST /ingest.
# Manter o navegador fora daqui deixa a imagem pequena e o deploy rapido.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RPA_DATA_DIR=/dados

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir \
        "openpyxl>=3.1,<4" \
        "fastapi>=0.115,<1" \
        "uvicorn[standard]>=0.32,<1" \
        "python-multipart>=0.0.9" \
    && pip install --no-cache-dir --no-deps .

# Roda como root de proposito: o volume do Railway e montado com dono root e
# um usuario sem privilegio nao consegue gravar nele. O container nao expoe
# shell nem executa conteudo enviado; apenas le planilhas e grava a base.
RUN mkdir -p /dados

EXPOSE 8000

CMD ["copercitrus-web"]
