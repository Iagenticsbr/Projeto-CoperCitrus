# false exibe o Chromium (padrao). Buscape, Zoom e Bing recusam o Chromium
# headless, entao true so funciona com RPA_BROWSER_CDP_URL.
RPA_HEADLESS=false

# Deixe vazio para usar o Chromium do Playwright. Valores opcionais: chrome ou msedge.
RPA_BROWSER_CHANNEL=

RPA_BROWSER_TIMEOUT_SECONDS=45
RPA_SLOW_MO_MS=0

# Intervalo entre pesquisas para reduzir carga nos sites.
REQUEST_DELAY_SECONDS=2.0
RESULT_LIMIT=5
